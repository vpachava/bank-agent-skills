{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architectural Handoff State",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version indicator"
    },
    "initiative_id": {
      "type": "string",
      "description": "Unique identifier for the modernization/architectural initiative"
    },
    "current_phase": {
      "type": "string",
      "enum": ["discovery", "design", "hardening", "governance", "migration"],
      "description": "Lifecycle phase of the current initiative"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generated_by": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      },
      "required": ["generated_by", "timestamp"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "domain": {"type": "string"},
          "description": {"type": "string"},
          "verifiable_evidence_paths": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["id", "description"]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["regulatory", "technical", "business"]},
          "description": {"type": "string"},
          "reference": {"type": "string"}
        },
        "required": ["type", "description"]
      }
    }
  },
  "required": ["version", "initiative_id", "current_phase", "metadata", "findings", "constraints"]
}
